# --- AWS -- real, full CloudFormation-registry coverage (this checkpoint) ---
#
# Superseded the earlier SQS-only Smithy entry: AWS's own real Smithy
# models are published one file per service (github.com/aws/
# api-models-aws has no single, merged, whole-of-AWS model), a real,
# structural limit this pipeline never worked around for Smithy
# specifically. schema_source = "cloudformation" doesn't have that
# limit -- one real, live registry zip (schema.cloudformation.<region>.
# amazonaws.com) covers every real AWS::-namespaced CFN resource type at
# once (1,705 real types live-fetched, 1,700 built). Real execution goes
# through Cloud Control API, a fixed, generic, resource-type-agnostic
# operation set (internal/cloudformation/ccapi in ubx-provider-dynamic)
# -- base_url is CCAPI's own real, single regional endpoint, unrelated
# to how many resource types this one entry serves.
#
# describe_exclude (cli/describeexclude.go): AWS::QuickSight::Dashboard/
# Analysis/Template are real, deeply-nested visualization-definition
# schemas (707 real "definitions" in Dashboard's own 336KB raw schema
# file, confirmed live, not a translator bug) that expand to 77,457 of
# the registry's 126,624 real fields at a real ~0.1% sourced rate --
# deeply-nested visual/chart configuration nobody hand-authors. Excluded
# from description generation only; all three still generate completely
# normal, full bindings.
[dynamic_providers.aws]
schema_source = "cloudformation"
schema_url = "https://schema.cloudformation.us-east-1.amazonaws.com/CloudformationSchema.zip"
base_url = "https://cloudcontrolapi.us-east-1.amazonaws.com"
describe_exclude = [
  "aws_quick_sight_dashboard",
  "aws_quick_sight_analysis",
  "aws_quick_sight_template",
]

[dynamic_providers.aws.auth]
type = "aws_sigv4"
[dynamic_providers.aws.auth.params]
region = "us-east-1"
service = "cloudcontrolapi"
credential_source = "profile"

# --- Azure -- real schema fetch and real resource discovery both
# verified working, live ---
#
# schema_url is a real, current, pinned Azure Compute resource-provider
# Swagger 2.0 file (Azure's own real spec format, NOT OpenAPI 3.x, and
# NOT single-file: it references a real, external "common-types"
# definitions file by real relative path, which ubx-provider-dynamic's
# own loader resolves -- see internal/openapi/load_live_test.go's own
# TestLive_AzureSwaggerWithExternalRefs).
#
# The real gap this comment used to describe here (Azure's own real ARM
# API convention uses PUT, not POST, to create/upsert a resource, and
# resourcemap.Discover's own create-detection heuristic only recognized
# POST) was fixed in ubx-provider-dynamic commit a61e489 ("resourcemap:
# recognize PUT-to-item-path as a real, generic create signal -- fixes
# Azure ARM's own real convention"), 2026-08-19 -- this comment was
# simply never updated afterward, and caused a real, live misreport one
# phase later (UBI-175 Phase 2 read this comment and reported Azure as
# still blocked) before being caught and corrected in UBI-175 Phase 3 by
# re-running the current binary against this exact entry: 19 real
# resource types discovered, zero errors. `ubx sdk gen` against this
# entry works end to end today.
#
# auth follows Azure AD's own real, standard client-credentials
# convention (the identical real oauth2_client_credentials type Phase 2
# already implements and live-verified against a different real OAuth2
# service) -- NOT live-verified against Azure AD specifically this
# session.
[dynamic_providers.azure]
schema_source = "openapi"
schema_url = "https://raw.githubusercontent.com/Azure/azure-rest-api-specs/main/specification/compute/resource-manager/Microsoft.Compute/Compute/stable/2026-04-01/ComputeRP.json"
base_url = "https://management.azure.com"

[dynamic_providers.azure.auth]
type = "oauth2_client_credentials"
[dynamic_providers.azure.auth.params]
token_url = "https://login.microsoftonline.com/AZURE_TENANT_ID/oauth2/v2.0/token"
client_id_env = "AZURE_CLIENT_ID"
client_secret_env = "AZURE_CLIENT_SECRET"
scopes = ["https://management.azure.com/.default"]

# --- Google Cloud ("google," matching the real, already-published
# ubx-sdk-google repo name) -- schema layer real and working ---
#
# GCP's own real API surface is published as Discovery Documents
# (discoveryVersion "v1," a "resources.*.methods.*" operation tree, GCP's
# own "schemas" for component types) -- a genuinely different real JSON
# format from both OpenAPI/Swagger and Smithy (no "swagger"/"openapi"
# field, no "paths" at all). ubx-provider-dynamic's own
# internal/discoverydoc package (a real, third schema-source engine,
# alongside internal/openapi and internal/smithy) now recognizes
# schema_source = "discovery_docs" for real -- confirmed live, schema
# layer only, against this EXACT URL: 95 real resources, 6,235 fields,
# 28% real sourced descriptions (GCP's own Discovery Documents carry
# unusually rich real prose), the generated Go SDK `go build`/`go vet`
# clean against a real ubx-sdk-go runtime checkout.
#
# Real, deliberate, honestly-scoped limitation, NOT yet done: schema
# discovery + translation only, the identical real precedent this
# pipeline's own Kubernetes checkpoint set -- real REST wire execution
# (Configure/Create/Read/Update/Delete actually calling
# compute.googleapis.com) is separate, NOT-yet-attempted work, matching
# Smithy's own real Phase 1 -> Phase 4 staging. A `ubx sdk gen` run
# against this entry generates real, buildable bindings; it does not yet
# serve real CRUD RPCs.
[dynamic_providers.google]
schema_source = "discovery_docs"
schema_url = "https://www.googleapis.com/discovery/v1/apis/compute/v1/rest"
base_url = "https://compute.googleapis.com/compute/v1"

