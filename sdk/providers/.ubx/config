# sdk/providers/.ubx/config -- the real, central, Ubiquex-owned provider
# config for the generic SDK-onboarding pipeline (`ubx sdk gen`).
#
# WHERE this lives, and why: inside the `ubiquex` monorepo itself, not a
# separate repo. This file is tightly coupled to the pipeline code that
# consumes it (cli/dynamicprovider.go, cli/sdk.go's own DynamicProviders
# handling) -- keeping them in the same repo means a real config-shape
# change and the code that reads it are reviewed together, never able to
# drift apart the way a cross-repo split would risk. It lives under
# sdk/providers/ (a sibling of sdk/codegen, sdk/conformance) rather than
# the repo root's own .ubx/config, because THIS file is never meant to be
# a real, ambient config for `ubx resolve`/`ubx ship` run from this
# repo's own root -- it is scoped, deliberately, to exactly the directory
# a real "ubx sdk gen" invocation for this pipeline is run from:
#
#   cd sdk/providers && ubx sdk gen --lang go --out ../generated
#
# WHAT format: real TOML, the [dynamic_providers.<name>] table shape --
# not a new, invented format. This is the IDENTICAL real table shape
# ubx-provider-dynamic's own internal/config package already defines and
# validates, the same shape checkpoint 2's own cli/dynamicprovider.go
# already reads generically (Config.DynamicProviders
# map[string]map[string]any). Two distinct entry shapes share this one
# table, picked by field presence alone (cli/dynamicprovider.go's own
# pinnedSchemaFields, no separate flag): "source"+"version" (pinned --
# provider.AcquireSchema resolves a cached or downloaded, checksum-
# verified github.com/Ubiquex/ubx-schema-<name> snapshot, zero network
# once cached) or schema_source/schema_url/base_url/auth/... (live --
# ubx-provider-dynamic fetches schema_url fresh on every launch).
#
# UBI-182/UBI-197: all six real providers below were switched from live
# to pinned this session -- each provider used to be a whole
# [dynamic_provider_groups.<name>_all] table plus one
# [dynamic_providers.<name>_<member>] entry per real member (up to 430,
# for AWS), one live schema_url fetch per member, per `ubx sdk gen`
# invocation. Two separate invocations (--dump-ir for schema.json,
# --lang go --out for the real Go source -- gen_all_data_source_pages.py
# in ubiquex-docs needs both) each refetched independently; if the
# underlying spec changed between them (confirmed live for Azure, whose
# real upstream spec is fetched unpinned from a moving branch tip), the
# two invocations could genuinely disagree on which wires are resources
# vs. data sources, silently. Pinning both invocations to the identical,
# already-downloaded snapshot closes this at the root: verified live,
# post-switch, zero disagreement between --dump-ir and --lang go --out
# for any of the 13,458 real types (resources + data sources) across all
# six providers.
#
# WHY this is distinct from any user's own .ubx/config: a real user's own
# .ubx/config lives in THEIR OWN stack's directory and declares only the
# providers THEIR stack actually uses, for real infra changes (ubx
# resolve/ubx ship read it). This file is never used for real infra --
# only `ubx sdk gen`, run from sdk/providers/, ever reads it, and it
# exists purely to drive SDK codegen/doc generation for the six providers
# this project maintains published bindings for.
#
# NAMING: each [dynamic_providers.<name>] table's own key IS the target
# SDK repo's own short name (github.com/ubiquex/ubx-sdk-<name>) --
# mechanically, via cli/sdk.go's own existing providerShortName, the
# SAME real, deliberate "never a hand-curated rename table" discipline
# sdk/codegen/ir.go's own doc comment already established for AWS
# service-package naming. This is why the real, already-published GCP
# bindings repo (github.com/ubiquex/ubx-sdk-google, confirmed against
# the real, existing checkout on disk) means this file's own GCP entry
# is named "google," not "gcp" -- matching the real, already-live repo
# name, not the task-brief's own prose shorthand.
#
# ADDING A SEVENTH PROVIDER: it won't have a published ubx-schema-<name>
# snapshot yet, so it starts live -- one new [dynamic_providers.<name>]
# table using whichever schema_source ubx-provider-dynamic already
# supports for that provider's own real source format (openapi,
# cloudformation, smithy, or discovery_docs today). Once a real snapshot
# exists (internal/snapshot's own --generate-snapshot(-group), a real
# ubx-schema-<name> repo, a real published release), switch this same
# table to source/version, matching the six below -- nothing else in
# this repo needs to change. If something else DOES turn out to need
# touching, that is a real finding about a real gap in the pipeline's
# own genericity, not something to silently work around here.

[dynamic_providers.kubernetes]
source = "ubiquex/kubernetes"
version = "3.0.1"

[dynamic_providers.github]
source = "ubiquex/github"
version = "1.0.1"

[dynamic_providers.datadog]
source = "ubiquex/datadog"
version = "1.0.1"

[dynamic_providers.aws]
source = "ubiquex/aws"
version = "1.0.0"

[dynamic_providers.azure]
source = "ubiquex/azure"
version = "1.0.1"

[dynamic_providers.google]
source = "ubiquex/google"
version = "1.0.1"
