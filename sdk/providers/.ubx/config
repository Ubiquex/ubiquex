# UBI-216/UBI-222: seventh provider, DigitalOcean -- proving case for
# the ubx-provider-runbook onboarding runbook, driven end to end through
# /onboard-provider. 59 resources + 137 data sources (196 wire types),
# 10,609 real fields (1,627 already provider-sourced, 8,982 genuinely
# undescribed). Generation needs a real, one-time Redocly bundling step
# (config.Provider.RedoclyBundle's own doc comment in
# ubx-provider-dynamic has the full reason: two Redocly-only $ref
# conventions real OpenAPI 3.0 does not define) -- already baked into
# this pin's own committed RawSpec, not needed again at resolution time.
# ubx-schema-digitalocean's own real push was blocked by GitHub's
# secret-scanning push protection on a Slack webhook URL PATTERN that is
# DigitalOcean's own real, verbatim documentation placeholder text
# (verified against the exact committed bytes, not assumed) -- allowed
# by the founder, real v1.0.0 release cut and verified after.
[dynamic_providers.digitalocean]
source = "ubiquex/digitalocean"
version = "1.0.1"

# UBI-222: eighth provider, Cloudflare -- the real end-to-end runbook
# test, driven by /onboard-provider rather than by hand. Pinned to
# ubx-schema-cloudflare's own real v1.0.1 release (264 resources + 820
# data sources = 1084 wire types), generated by ubx-provider-dynamic
# v1.0.9 -- the first released version carrying the findCreate
# inline-envelope fix (ubx-provider-dynamic PR #60): Cloudflare's
# generic response envelope caused 19 resources to have their create
# operation silently bound to the wrong endpoint, and 4 more
# (cloudflare_abuse_report, cloudflare_physical_device,
# cloudflare_registration, cloudflare_tenant) to appear falsely
# creatable with no real create at all -- dropped from this release.
# The prior v1.0.0/v1.0.8 pair (268 resources) carried both. Unlike
# DigitalOcean, this spec loads cleanly through openapi.Load as
# published -- no redocly_bundle needed. namespace_from_tags = true is
# a real, flagged judgment call, not a clean win the way it was for
# DigitalOcean -- see sdk/providers/.onboarding/cloudflare.json for the
# full real numbers.
[dynamic_providers.cloudflare]
source = "ubiquex/cloudflare"
version = "1.0.1"
