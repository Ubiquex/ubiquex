This change creates 1, modifies 1 and destroys 1 resource(s).

== CREATE (1) ==

+ create payments.aws_db_instance.payments-db-replica
    config.allocated_storage = 100
    config.engine = "postgres"
    config.instance_class = "db.r6g.large"
    config.parameter_overrides = {}
    config.password = {"$secret":{"backend":"aws_secrets_manager","path":"db-password"}}
    config.replicate_source_db = {"$computed":{"from":"payments.aws_db_instance.payments-db.identifier"}}
    config.tags.Environment = "prod"
    config.tags.Owner = "payments-team"
    depends_on[0] = "payments.aws_db_instance.payments-db"

== MODIFY (1) ==

~ modify payments.aws_s3_bucket.payments-logs
    lifecycle_days
      before  (not set)
      after   30
    tags.Environment
      before  "staging"
      after   "prod"
    versioning
      before  false
      after   (not set)
    provider.source = "registry.terraform.io/hashicorp/aws"
    provider.version = "6.2.0"

== DESTROY (1) ==

- destroy payments.aws_elasticache_cluster.payments-cache
    state.engine = "redis"
    state.node_type = "cache.t3.micro"
    state.num_cache_nodes = 1

